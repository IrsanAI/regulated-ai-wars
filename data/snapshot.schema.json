{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irsanai.github.io/regulated-ai-wars/data/snapshot.schema.json",
  "title": "regulated-ai-wars board snapshot",
  "type": "object",
  "required": ["meta", "players", "territories", "geoDominance", "events", "pipeline"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["snapshotDate", "version", "note"],
      "properties": {
        "snapshotDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "version": { "type": "string" },
        "note": { "type": "string", "minLength": 8 }
      },
      "additionalProperties": true
    },
    "players": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name", "short", "hex", "role", "momentum"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "short": { "type": "string" },
          "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "role": { "type": "string" },
          "momentum": { "type": "string", "enum": ["up", "stable", "down"] }
        },
        "additionalProperties": true
      }
    },
    "territories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "meta", "status", "influence", "note"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "meta": { "type": "string" },
          "status": { "type": "string", "enum": ["hot", "contested", "normal", "cold"] },
          "influence": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "trend": {
            "type": "object",
            "additionalProperties": { "type": "string", "enum": ["up", "stable", "down"] }
          },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "movers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["player", "territory", "trend"],
        "properties": {
          "player": { "type": "string" },
          "territory": { "type": "string" },
          "trend": { "type": "string", "enum": ["up", "stable", "down"] },
          "delta": { "type": "number" },
          "label": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "geoDominance": {
      "type": "object",
      "required": ["na", "sa", "eu", "af", "as", "oc"],
      "additionalProperties": {
        "type": "object",
        "required": ["dominant", "intensity", "note"],
        "properties": {
          "dominant": { "type": "string" },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "trend": { "type": "string", "enum": ["up", "stable", "down"] },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "text"],
        "properties": {
          "time": { "type": "string" },
          "text": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "pipeline": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
